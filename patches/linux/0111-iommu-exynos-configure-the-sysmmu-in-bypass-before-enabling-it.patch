From e2549d5f3c84a2cc2e748651c7fb0de6b3f9c674 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 10 Oct 2026 23:34:43 +0200
Subject: [PATCH] iommu/exynos: configure the SysMMU in bypass before enabling
 it

CTRL_BLOCK sets the enable bit as well, and it was the first write of
__sysmmu_enable(): translation started with the reset or bootloader
values of MMU_CFG and PT_BASE still in place. For a master that is idle
at that point nothing is walked, but the DECON of exynos7870 keeps
scanning out the bootloader's framebuffer while its SysMMU is enabled,
and once in a while a read was walked from the stale base and ended in
an unrecoverable page table walk fault.

Write the configuration and the page table base while the block is
still in bypass, then block, wait for the block to take effect, flush
again and enable. At probe, clear a fault the bootloader left pending
and invalidate the TLB and FLPD cache.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/iommu/exynos-iommu.c | 29 ++++++++++++++++++++++++++++-
 1 file changed, 28 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/exynos-iommu.c b/drivers/iommu/exynos-iommu.c
index 874d05f4b3..7f141bb44a 100644
--- a/drivers/iommu/exynos-iommu.c
+++ b/drivers/iommu/exynos-iommu.c
@@ -543,6 +543,22 @@ static void __sysmmu_get_version(struct sysmmu_drvdata *data)
 			data->variant = &sysmmu_v7_variant;
 	}
 
+	/*
+	 * Start from a known state: a fault the bootloader left pending, and
+	 * TLB or FLPD cache entries from its use of the block, would otherwise
+	 * meet the first translation.
+	 */
+	if (MMU_MAJ_VER(data->version) >= 5) {
+		u32 st = readl(SYSMMU_REG(data, int_status));
+
+		if (st) {
+			dev_warn(data->sysmmu, "fault left by the bootloader: %#x at %#x\n",
+				 st, readl(data->sfrbase + REG_V5_FAULT_AR_VA));
+			writel(st, SYSMMU_REG(data, int_clear));
+		}
+		__sysmmu_tlb_invalidate(data);
+	}
+
 	__sysmmu_disable_clocks(data);
 }
 
@@ -648,14 +664,25 @@ static void __sysmmu_enable_vid(struct sysmmu_drvdata *data)
 static void __sysmmu_enable(struct sysmmu_drvdata *data)
 {
 	unsigned long flags;
+	int i;
 
 	__sysmmu_enable_clocks(data);
 
 	spin_lock_irqsave(&data->lock, flags);
-	writel(CTRL_BLOCK, data->sfrbase + REG_MMU_CTRL);
+	/*
+	 * CTRL_BLOCK also enables translation: write the configuration and the
+	 * page table base while the block is still in bypass, or a master
+	 * already doing DMA, such as a display scanning out the bootloader's
+	 * framebuffer, has its next accesses walked from a stale base.
+	 */
 	__sysmmu_init_config(data);
 	__sysmmu_set_ptbase(data, data->pgtable);
+	writel(CTRL_BLOCK, data->sfrbase + REG_MMU_CTRL);
+	for (i = 0; i < 4096 && !(readl(data->sfrbase + REG_MMU_STATUS) & 1); i++)
+		;
+	__sysmmu_tlb_invalidate(data);
 	__sysmmu_enable_vid(data);
+	readl(data->sfrbase + REG_MMU_STATUS);
 	writel(CTRL_ENABLE, data->sfrbase + REG_MMU_CTRL);
 	data->active = true;
 	spin_unlock_irqrestore(&data->lock, flags);
