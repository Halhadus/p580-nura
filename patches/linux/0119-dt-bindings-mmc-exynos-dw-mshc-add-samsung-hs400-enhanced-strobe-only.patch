From 9d23d525321b9fe2329a3312abf3ef2e48dc7b9f Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 29 Oct 2026 08:52:43 +0100
Subject: [PATCH] dt-bindings: mmc: exynos-dw-mshc: add
 samsung,hs400-enhanced-strobe-only

On some boards samsung,read-strobe-delay is only known to work with
enhanced strobe, and plain HS400 with it is not trusted. Add a property
for them: a card that cannot do HS400ES then stays in HS200.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 .../devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml    | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml b/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
index 223fcc9f65..d37884fd21 100644
--- a/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
+++ b/Documentation/devicetree/bindings/mmc/samsung,exynos-dw-mshc.yaml
@@ -113,6 +113,13 @@ properties:
       RCLK (Data strobe) delay to control HS400 mode (Latency value for delay
       line in Read path). If missing, default from hardware is used.
 
+  samsung,hs400-enhanced-strobe-only:
+    type: boolean
+    description:
+      Use HS400 only with enhanced strobe, and keep cards that do not support
+      it in HS200, for boards where samsung,read-strobe-delay is known to work
+      only with enhanced strobe.
+
 required:
   - compatible
   - reg
