From: Halhadus <eneshakan45@proton.me>
Subject: [PATCH] media: i2c: sr259 and s5k4h5yc: enable supplies sequentially

Both sensor drivers require the downstream supply order, but
regulator_bulk_enable() schedules each enable asynchronously. Use
sequential regulator_enable() calls and unwind only successful enables
in reverse order. Keep existing clock/reset timing; add the SR259
10 us I/O-to-analog delay from the pinned downstream power sequence.
This fixes ordering, not a claim that camera capture now works.

Signed-off-by: Halhadus <eneshakan45@proton.me>
---
diff --git a/drivers/media/i2c/sr259.c b/drivers/media/i2c/sr259.c
--- a/drivers/media/i2c/sr259.c
+++ b/drivers/media/i2c/sr259.c
@@ -773,13 +773,16 @@
 {
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct sr259 *sensor = to_sr259(sd);
-	int ret;
+	int i, ret;
 
 	/* The vendor order: supplies, clock, standby released, reset released. */
-	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
-				    sensor->supplies);
-	if (ret)
-		return ret;
+	for (i = 0; i < ARRAY_SIZE(sensor->supplies); i++) {
+		ret = regulator_enable(sensor->supplies[i].consumer);
+		if (ret)
+			goto err_supplies;
+		if (i == 0)
+			usleep_range(10, 20);
+	}
 	usleep_range(10000, 11000);
 
 	ret = clk_prepare_enable(sensor->mclk);
@@ -795,7 +798,8 @@
 	return 0;
 
 err_supplies:
-	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	while (i--)
+		regulator_disable(sensor->supplies[i].consumer);
 	return ret;
 }
 
diff --git a/drivers/media/i2c/s5k4h5yc.c b/drivers/media/i2c/s5k4h5yc.c
--- a/drivers/media/i2c/s5k4h5yc.c
+++ b/drivers/media/i2c/s5k4h5yc.c
@@ -416,16 +416,17 @@
 {
 	struct v4l2_subdev *sd = dev_get_drvdata(dev);
 	struct s5k4h5yc *sensor = to_s5k4h5yc(sd);
-	int ret;
+	int i, ret;
 
 	/*
-	 * The vendor order is analog, core, I/O, then the clock and the
-	 * reset; the bulk API enables them in the order of the array.
+	 * The vendor order is analog, core, I/O, then the clock and reset.
+	 * regulator_bulk_enable() enables rails asynchronously.
 	 */
-	ret = regulator_bulk_enable(ARRAY_SIZE(sensor->supplies),
-				    sensor->supplies);
-	if (ret)
-		return ret;
+	for (i = 0; i < ARRAY_SIZE(sensor->supplies); i++) {
+		ret = regulator_enable(sensor->supplies[i].consumer);
+		if (ret)
+			goto err_supplies;
+	}
 	usleep_range(2000, 2500);
 
 	ret = clk_prepare_enable(sensor->mclk);
@@ -439,7 +440,8 @@
 	return 0;
 
 err_supplies:
-	regulator_bulk_disable(ARRAY_SIZE(sensor->supplies), sensor->supplies);
+	while (i--)
+		regulator_disable(sensor->supplies[i].consumer);
 	return ret;
 }
 
