From 09131f50e2418da0455cec989e713825ae1ac72d Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 6 Nov 2026 16:22:10 +0100
Subject: [PATCH] media: i2c: sr259: leave the frame length to the sensor

The sensor runs with a variable frame length, as set by its register
table: it stretches the frame by itself when the exposure needs it.
Writing the frame length registers while it streams made it send more
lines than a frame has, and the CSIS DMA ran off the end of the buffer
into a fatal System MMU fault. VBLANK now only widens the exposure range.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/media/i2c/sr259.c | 18 ++++++++----------
 1 file changed, 8 insertions(+), 10 deletions(-)

diff --git a/drivers/media/i2c/sr259.c b/drivers/media/i2c/sr259.c
index 05268fec71..38758f9307 100644
--- a/drivers/media/i2c/sr259.c
+++ b/drivers/media/i2c/sr259.c
@@ -43,8 +43,6 @@
 #define SR259_REG_ID			CCI_REG8(0x04)
 #define SR259_REG_REV			CCI_REG8(0x05)
 #define SR259_REG_HOLD			CCI_REG8(0x1f)
-#define SR259_REG_FLL_H			CCI_REG8(0x4e)
-#define SR259_REG_FLL_L			CCI_REG8(0x4f)
 
 /* page 0x20 */
 #define SR259_REG_EXPOSURE_H		CCI_REG8(0x22)
@@ -828,8 +826,14 @@ static int sr259_set_ctrl(struct v4l2_ctrl *ctrl)
 					       sensor->exposure->minimum, max,
 					       sensor->exposure->step,
 					       min_t(s64, sensor->exposure->default_value, max));
-		if (ret)
-			return ret;
+
+		/*
+		 * The sensor runs with a variable frame length: it stretches
+		 * the frame by itself when the exposure needs it, and the
+		 * frame length registers are not for changing while it
+		 * streams, the DMA gets more lines than a frame has.
+		 */
+		return ret;
 	}
 
 	if (!pm_runtime_get_if_in_use(sensor->dev))
@@ -850,12 +854,6 @@ static int sr259_set_ctrl(struct v4l2_ctrl *ctrl)
 		cci_write(sensor->regmap, SR259_REG_AGAIN_MSB, code >> 1, &ret);
 		cci_write(sensor->regmap, SR259_REG_AGAIN_LSB, code & 1, &ret);
 		break;
-	case V4L2_CID_VBLANK:
-		cci_write(sensor->regmap, SR259_REG_FLL_H,
-			  (SR259_HEIGHT + ctrl->val) >> 8, &ret);
-		cci_write(sensor->regmap, SR259_REG_FLL_L,
-			  (SR259_HEIGHT + ctrl->val) & 0xff, &ret);
-		break;
 	default:
 		break;
 	}
