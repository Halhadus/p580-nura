From af225eefde95a18965275c48565aa7c225b751c2 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 30 Oct 2026 19:02:40 +0100
Subject: [PATCH] dt-bindings: display: panel: himax,hx8279: add the gtaxl
 panels

The Samsung Galaxy Tab A 10.1 (2016) ships with one of three panels on
the HX8279-D DriverIC: two from BOE and one from Chunghwa Picture Tubes.
They share the module, the timings and the power sequence, and differ
in the init table. Add a compatible for each.

These panels have no external backlight: the DriverIC drives it, and
the driver already supports that. Require the backlight property only
for the panels that need one.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 .../bindings/display/panel/himax,hx8279.yaml      | 15 ++++++++++++++-
 1 file changed, 14 insertions(+), 1 deletion(-)

diff --git a/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml b/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml
index f619aea82b..cc048c2205 100644
--- a/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml
+++ b/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml
@@ -19,12 +19,26 @@ description:
 
 allOf:
   - $ref: panel-common-dual.yaml#
+  - if:
+      properties:
+        compatible:
+          contains:
+            enum:
+              - aoly,sl101pm1794fog-v15
+              - startek,kd070fhfid078
+    then:
+      required:
+        - backlight
 
 properties:
   compatible:
     items:
       - enum:
           - aoly,sl101pm1794fog-v15
+          # The three panels of the Samsung Galaxy Tab A 10.1 (2016)
+          - boe,hx8279d-gtaxl
+          - boe,hx8279d-gtaxl-v2
+          - chunghwa,hx8279d-gtaxl
           - startek,kd070fhfid078
       - const: himax,hx8279
 
@@ -40,7 +54,6 @@ properties:
 required:
   - compatible
   - reg
-  - backlight
   - reset-gpios
   - iovcc-supply
   - vdd-supply
