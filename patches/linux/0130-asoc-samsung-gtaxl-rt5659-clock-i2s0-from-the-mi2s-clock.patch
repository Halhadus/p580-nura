From ed1a30e6777f4642484d2b2f57b71689c5592f9a Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 1 Nov 2026 20:54:50 +0100
Subject: [PATCH] ASoC: samsung: gtaxl_rt5659: clock I2S0 from the MI2S clock

In clock provider mode the Samsung I2S driver defaults the RCLK source
to IISMOD[10] = 0, which on Exynos 7870 is the APB clock (~99.94 MHz).
The prescaler is computed from that rate and cannot divide it down to
the audio rates: playback ran at 99.9375 MHz / 4 / 512 = 48797.6 Hz
instead of 48 kHz, so everything sounded about 1.7% fast and sharp.

Select RCLKSRC_1, the MI2S divider of the AUD PLL, in hw_params. The
I2S driver then reads its rate and sets an exact prescaler: measured
48000 Hz on the PCM hardware pointer.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 sound/soc/samsung/gtaxl_rt5659.c | 14 +++++++++++++-
 1 file changed, 13 insertions(+), 1 deletion(-)

diff --git a/sound/soc/samsung/gtaxl_rt5659.c b/sound/soc/samsung/gtaxl_rt5659.c
index 7c98ddc23e..2b5c6da173 100644
--- a/sound/soc/samsung/gtaxl_rt5659.c
+++ b/sound/soc/samsung/gtaxl_rt5659.c
@@ -91,7 +91,19 @@ static int gtaxl_aif1_hw_params(struct snd_pcm_substream *substream,
 		return -EINVAL;
 	}
 
-	/* CPU: CDCLK out at rfs, root clock from CMU, BCLK divider */
+	/*
+	 * CPU: root clock from the MI2S divider of the AUD PLL.  The
+	 * default source in provider mode is the APB clock, which does
+	 * not divide to the audio rates (48.8 kHz instead of 48 kHz).
+	 */
+	ret = snd_soc_dai_set_sysclk(cpu_dai, SAMSUNG_I2S_RCLKSRC_1, 0,
+				     SND_SOC_CLOCK_IN);
+	if (ret < 0) {
+		dev_err(rtd->card->dev, "failed to set RCLK source: %d\n", ret);
+		return ret;
+	}
+
+	/* CPU: CDCLK out at rfs, BCLK divider */
 	ret = snd_soc_dai_set_sysclk(cpu_dai, SAMSUNG_I2S_CDCLK,
 				     rfs, SND_SOC_CLOCK_OUT);
 	if (ret < 0) {
