From 084245d209004677b3b978f01c6b5244279bc7c2 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 10 Sep 2026 12:59:38 +0000
Subject: [PATCH] drm/panel: himax-hx8279: configure the panel with its display
 off

The vendor init sequence turns the display off and the backlight duty
to zero before it writes a single table (page 0 register B3 = 0x88,
page 4 register B8 = 0x00), writes everything with the panel not
driving the glass, and only then turns the display on again with
B3 = 0x08, after the controller has been started. It never sends DCS
set_display_on or set_display_off to this DriverIC, the same way it
never sends enter_sleep_mode, and DCS reads on this link time out, so
the standard command set cannot be assumed to be implemented at all.

Here the whole configuration, the gate driver registers included, is
written to a panel that is already displaying, and the display is
switched with DCS. Against the vendor BOE table, this is the last
difference in what the panel is told and when.

Follow the vendor: display and backlight off at the top of
hx8279_on(), B3 = 0x08 in enable(), B3 = 0x8c in disable() to match
the exit sequence used in unprepare(). The page lock is taken in
enable() and disable() because a backlight update may otherwise switch
pages between the page select and the write.

hx8279_set_page() skips the B0 write when the cached page is already
selected. On the bootloader handoff path the DriverIC is still on
whatever page the bootloader left it, typically the backlight page 4,
while the cache holds zero: the display-on write in enable() would land
on page 4 and come up as a very dim panel. Mark the page as unknown
when taking over from the bootloader, so that the first switch is
always sent.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 53 ++++++++++++++++++----
 1 file changed, 43 insertions(+), 10 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index 15ec081de0..580351de87 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -25,6 +25,7 @@
 
 /* Page selection */
 #define HX8279_REG_PAGE			0xb0
+ #define HX8279_PAGE_UNKNOWN			0xff
  #define HX8279_PAGE_SEL		GENMASK(3, 0)
 
 /* Page 0 - Driver/Module Configuration */
@@ -32,6 +33,8 @@
  #define HX8279_P0_SLEEP_IN		0x00
 #define HX8279_P0_DISPLAY_CTRL		0xb3
  #define HX8279_P0_DISPLAY_OFF_BL_OFF		0x8c
+ #define HX8279_P0_DISPLAY_OFF		0x88
+ #define HX8279_P0_DISPLAY_ON		0x08
 #define HX8279_P0_UNKNOWN_B6		0xb6
 #define HX8279_P0_UNKNOWN_BA		0xba
 #define HX8279_P0_VGHS			0xbf
@@ -855,6 +858,21 @@ static int hx8279_on(struct hx8279 *hx)
 {
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
+	const u8 cmd_display_off[] = { HX8279_P0_DISPLAY_CTRL,
+				       HX8279_P0_DISPLAY_OFF };
+	const u8 cmd_bl_off[] = { HX8279_P4_REG_BRIGHTNESS, 0x00 };
+
+	/*
+	 * Pages 0 and 4: as the vendor does, turn the display and the
+	 * backlight off so that the tables below reach a panel that is not
+	 * driving the glass.
+	 */
+	hx8279_set_page(hx, &dsi_ctx, 0);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_display_off,
+				     ARRAY_SIZE(cmd_display_off));
+	hx8279_set_page(hx, &dsi_ctx, 4);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_bl_off,
+				     ARRAY_SIZE(cmd_bl_off));
 
 	/* Page 5 */
 	hx8279_set_mipi_cfg(hx, &dsi_ctx);
@@ -923,7 +941,14 @@ static int hx8279_disable(struct drm_panel *panel)
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
-	mipi_dsi_dcs_set_display_off_multi(&dsi_ctx);
+	const u8 cmd_display_off[] = { HX8279_P0_DISPLAY_CTRL,
+				       HX8279_P0_DISPLAY_OFF_BL_OFF };
+
+	mutex_lock(&hx->page_lock);
+	hx8279_set_page(hx, &dsi_ctx, 0);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_display_off,
+				     ARRAY_SIZE(cmd_display_off));
+	mutex_unlock(&hx->page_lock);
 
 	return 0;
 }
@@ -934,7 +959,14 @@ static int hx8279_enable(struct drm_panel *panel)
 	struct mipi_dsi_device *dsi = hx->dsi[0];
 	struct mipi_dsi_multi_context dsi_ctx = { .dsi = dsi };
 
-	mipi_dsi_dcs_set_display_on_multi(&dsi_ctx);
+	const u8 cmd_display_on[] = { HX8279_P0_DISPLAY_CTRL,
+				      HX8279_P0_DISPLAY_ON };
+
+	mutex_lock(&hx->page_lock);
+	hx8279_set_page(hx, &dsi_ctx, 0);
+	mipi_dsi_generic_write_multi(&dsi_ctx, cmd_display_on,
+				     ARRAY_SIZE(cmd_display_on));
+	mutex_unlock(&hx->page_lock);
 
 	return 0;
 }
@@ -957,17 +989,18 @@ static int hx8279_prepare(struct drm_panel *panel)
 		if (ret)
 			return ret;
 
+		/*
+		 * The DriverIC is on whatever page the bootloader left it:
+		 * invalidate the cache so the first page switch is sent.
+		 */
+		hx->last_page = HX8279_PAGE_UNKNOWN;
+
 		hx->handoff = false;
 
 		/*
-		 * The cold path raises MIPI_DSI_MODE_LPM further down and
-		 * it stays up for every later command. Taking this early
-		 * return without it leaves display-on and the backlight
-		 * writes going out as HS commands, and those only travel
-		 * inside the HS video stream: with scanout deliberately
-		 * not started yet, they sit in the header FIFO until the
-		 * first flush. LP escape transmission does not need video,
-		 * so use it on this path too.
+		 * As on the cold path, send commands in LP mode: HS
+		 * commands only travel inside the video stream, which is
+		 * not running yet.
 		 */
 		dsi->mode_flags |= MIPI_DSI_MODE_LPM;
 		if (hx->dsi[1])
