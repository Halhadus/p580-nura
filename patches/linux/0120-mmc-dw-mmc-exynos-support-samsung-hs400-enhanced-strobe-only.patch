From 4d017f5b5d80a753d58cd16d38675dbd8bc3ad22 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Thu, 29 Oct 2026 08:52:43 +0100
Subject: [PATCH] mmc: dw_mmc-exynos: support
 samsung,hs400-enhanced-strobe-only

Let a board ask for MMC_CAP2_HS400_ES_ONLY: on such a board plain HS400
with the read strobe delay it provides is not trusted, and a card that
cannot do HS400ES stays in HS200.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/mmc/host/dw_mmc-exynos.c | 2 ++
 1 file changed, 2 insertions(+)

diff --git a/drivers/mmc/host/dw_mmc-exynos.c b/drivers/mmc/host/dw_mmc-exynos.c
index 71c01bff2d..0e0c1472a8 100644
--- a/drivers/mmc/host/dw_mmc-exynos.c
+++ b/drivers/mmc/host/dw_mmc-exynos.c
@@ -476,6 +476,8 @@ static int dw_mci_exynos_parse_dt(struct dw_mci *host)
 			     &priv->txdt_crc_fastlimit);
 	of_property_read_u32(np, "samsung,dw-mshc-txdt-crc-timer-initval",
 			     &priv->txdt_crc_initval);
+	if (of_property_read_bool(np, "samsung,hs400-enhanced-strobe-only"))
+		host->mmc->caps2 |= MMC_CAP2_HS400_ES_ONLY;
 	host->priv = priv;
 	return 0;
 }
