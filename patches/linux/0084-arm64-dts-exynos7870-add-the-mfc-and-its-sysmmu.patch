From ab47fa33f6c2cfd0e5f389922bb67605af147cdd Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 20:55:33 +0200
Subject: [PATCH] arm64: dts: exynos7870: add the MFC and its SysMMU

Describe the Multi Format Codec v10 (version 0xa0b0) and the SysMMU in
front of it. The MFC power domain, MFCMSCL, is left on by the
bootloader, so no power domain node is referenced.

The MFC firmware addresses its buffers as offsets from its own base,
so nothing may be mapped below it. Reserve the bottom 16 MiB of the
MFC's IOVA space through an iommu-addresses region: the driver
allocates its 16 MiB firmware and context pool under 32 MiB, so the
pool lands right on top of the reservation and every video buffer
above it.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 42 ++++++++++++++++++++++
 1 file changed, 42 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index 0ee139bb45..ef684a34fd 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -236,6 +236,24 @@
 		};
 	};
 
+	reserved-memory {
+		#address-cells = <2>;
+		#size-cells = <1>;
+		ranges;
+
+		/*
+		 * IOVA space only, no memory: the MFC firmware addresses its
+		 * buffers as offsets from its base, so nothing may be mapped
+		 * below it. Reserving the bottom of the MFC's IOVA space puts
+		 * the firmware right above it and every later buffer higher.
+		 * 16 MiB, so that the driver's 16 MiB pool, allocated under
+		 * 32 MiB, sits right on top of it.
+		 */
+		mfc_iova: mfc-iova {
+			iommu-addresses = <&mfc 0x0 0x1000000>;
+		};
+	};
+
 	soc: soc@0 {
 		compatible = "simple-bus";
 		ranges = <0x0 0x0 0x0 0x20000000>;
@@ -431,6 +449,30 @@
 				 <&cmu_mif CLK_GOUT_MIF_CMU_MFCMSCL_MFC>,
 				 <&cmu_mif CLK_GOUT_MIF_CMU_MFCMSCL_MSCL>;
 		};
+		/*
+		 * Multi Format Codec v10 (version 0xa0b0). Its power domain,
+		 * MFCMSCL, is left on by the bootloader.
+		 */
+		mfc: codec@12c30000 {
+			compatible = "samsung,exynos7870-mfc";
+			reg = <0x12c30000 0x10000>;
+			interrupts = <GIC_SPI 354 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&cmu_mfcmscl CLK_GOUT_MFCMSCL_MFC>;
+			clock-names = "mfc";
+			iommus = <&sysmmu_mfc>;
+			memory-region = <&mfc_iova>;
+		};
+
+		sysmmu_mfc: iommu@12c90000 {
+			compatible = "samsung,exynos-sysmmu";
+			reg = <0x12c90000 0x1000>;
+			interrupts = <GIC_SPI 352 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <0>;
+
+			clocks = <&cmu_mfcmscl CLK_GOUT_MFCMSCL_MFC>;
+			clock-names = "sysmmu";
+		};
+
 
 		mmc0: mmc@13540000 {
 			compatible = "samsung,exynos7870-dw-mshc-smu";
