From 287fe2635230082a43db366116b5e4ac4a83d7ca Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Fri, 25 Sep 2026 13:32:36 +0200
Subject: [PATCH] arm64: dts: exynos7870: add the CSIS receivers and the ISP
 SysMMU

Add CSIS0 and CSIS1 (MIPI CSI-2 receivers v4.1, with DMA) and the
SysMMU that translates their write masters (sysmmu_isp0 at 0x14470000).
Addresses, interrupts and PHY indexes from the vendor device tree.

Both receivers write through sysmmu_isp0, and the SysMMU driver keeps
one master device per SysMMU, so they are described as a single node
with two register ranges, two interrupts, two PHYs and one port per
receiver: port 0 is CSIS0 (four lanes, PHY shared with DSIM0), port 1
is CSIS1. The node is disabled; a board enables it and connects the
ports it uses to its sensors.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 49 ++++++++++++++++++++++
 1 file changed, 49 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index 9b5ca42add..0ee139bb45 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -883,6 +883,55 @@
 			};
 		};
 
+		/*
+		 * CSIS0 and CSIS1, each a CSI-2 receiver with its own DMA. One
+		 * node because both write through sysmmu_isp0, and the SysMMU
+		 * driver takes one master device per SysMMU. Port 0 is CSIS0
+		 * (four lanes, PHY shared with DSIM0), port 1 is CSIS1.
+		 */
+		csis: csis@14420000 {
+			compatible = "samsung,exynos7870-csis";
+			reg = <0x14420000 0x10000>,
+			      <0x14460000 0x10000>;
+			interrupts = <GIC_SPI 144 IRQ_TYPE_LEVEL_HIGH>,
+				     <GIC_SPI 145 IRQ_TYPE_LEVEL_HIGH>;
+
+			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>,
+				 <&cmu_isp CLK_GOUT_ISP_CAM_HALF>;
+			clock-names = "aclk", "pclk";
+
+			phys = <&mipi_phy 0>, <&mipi_phy 2>;
+			phy-names = "csis0", "csis1";
+
+			iommus = <&sysmmu_isp0>;
+
+			status = "disabled";
+
+			ports {
+				#address-cells = <1>;
+				#size-cells = <0>;
+
+				csis0_port: port@0 {
+					reg = <0>;
+				};
+
+				csis1_port: port@1 {
+					reg = <1>;
+				};
+			};
+		};
+
+		/* The write masters of both CSIS DMA engines sit behind it. */
+		sysmmu_isp0: iommu@14470000 {
+			compatible = "samsung,exynos-sysmmu";
+			reg = <0x14470000 0x1000>;
+			interrupts = <GIC_SPI 128 IRQ_TYPE_LEVEL_HIGH>;
+			#iommu-cells = <0>;
+
+			clocks = <&cmu_isp CLK_GOUT_ISP_CAM>;
+			clock-names = "sysmmu";
+		};
+
 		cmu_isp: clock-controller@144d0000 {
 			compatible = "samsung,exynos7870-cmu-isp";
 			reg = <0x144d0000 0x1000>;
