From: Halhadus <eneshakans45@proton.me>
Subject: [PATCH] drm/panel: hx8279: add Samsung SM-P580 panel modes

Signed-off-by: Halhadus <eneshakans45@proton.me>
---
diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -1746,6 +1746,28 @@
 			.hsync_start = 1200 + 120,
 			.hsync_end = 1200 + 120 + 8,
 			.htotal = 1200 + 120 + 8 + 32,
+			.vdisplay = 1920,
+			.vsync_start = 1920 + 16,
+			.vsync_end = 1920 + 16 + 4,
+			.vtotal = 1920 + 16 + 4 + 16,
+			.width_mm = 135,
+			.height_mm = 216,
+			.type = DRM_MODE_TYPE_DRIVER
+		},
+		.bpc = 8,
+		.is_video_mode = true,
+	},
+};
+
+/* P580/P585 vendor timings: 162 MHz, HSA 30, 60 Hz nominal. */
+static const struct hx8279_panel_mode gtanotexl_modes[] = {
+	{
+		.mode = {
+			.clock = 162000,
+			.hdisplay = 1200,
+			.hsync_start = 1200 + 120,
+			.hsync_end = 1200 + 120 + 30,
+			.htotal = 1200 + 120 + 30 + 32,
 			.vdisplay = 1920,
 			.vsync_start = 1920 + 16,
 			.vsync_end = 1920 + 16 + 4,
@@ -2021,6 +2043,46 @@
 	.reset_pulse_ms = 10,
 };
 
+static const struct hx8279_panel_desc boe_hx8279d_gtanotexl = {
+	.dsi_info = {
+		.type = "HX8279D-BOE",
+		.channel = 0,
+		.node = NULL,
+	},
+	.mode_data = gtanotexl_modes,
+	.num_modes = ARRAY_SIZE(gtanotexl_modes),
+	.num_lanes = 4,
+
+	/* Driver/Module, GOA and gamma configuration from the vendor */
+	.init_regs = boe_hx8279d_gtaxl_init,
+	.num_init_regs = ARRAY_SIZE(boe_hx8279d_gtaxl_init),
+
+	/* MIPI Configuration */
+	.eotp_ctl = 0xe5,
+	.bta_tlpx = 2,
+	.lhs_settle_time_by_osc25 = true,
+	.ths_settle_time = 2,
+
+	/* Backlight over DSI */
+	.bl_duty_max = 168,
+	.bl_pwm_freq = 0x02,
+	.bl_unk_b6 = 0x02,
+
+	/*
+	 * Burst mode with the horizontal front porch blanking suppressed and
+	 * no sync pulses, which is what the vendor programs in video mode and
+	 * what the bootloader leaves in the DSIM config register.
+	 */
+	.video_mode_flags = MIPI_DSI_MODE_VIDEO |
+			    MIPI_DSI_MODE_VIDEO_BURST |
+			    MIPI_DSI_MODE_VIDEO_NO_HFP,
+
+	/* Power sequencing, from the vendor board file */
+	.iovcc_to_vdd_delay_ms = 10,
+	.vdd_to_reset_delay_ms = 15,
+	.reset_pulse_ms = 10,
+};
+
 static const struct hx8279_panel_desc boe_hx8279d_gtaxl_v2 = {
 	.dsi_info = {
 		.type = "HX8279D-BOE2",
@@ -2061,6 +2123,46 @@
 	.reset_pulse_ms = 10,
 };
 
+static const struct hx8279_panel_desc boe_hx8279d_gtanotexl_v2 = {
+	.dsi_info = {
+		.type = "HX8279D-BOE2",
+		.channel = 0,
+		.node = NULL,
+	},
+	.mode_data = gtanotexl_modes,
+	.num_modes = ARRAY_SIZE(gtanotexl_modes),
+	.num_lanes = 4,
+
+	/* Driver/Module, GOA and gamma configuration from the vendor */
+	.init_regs = boe_hx8279d_gtaxl_v2_init,
+	.num_init_regs = ARRAY_SIZE(boe_hx8279d_gtaxl_v2_init),
+
+	/* MIPI Configuration */
+	.eotp_ctl = 0xe5,
+	.bta_tlpx = 2,
+	.lhs_settle_time_by_osc25 = true,
+	.ths_settle_time = 2,
+
+	/* Backlight over DSI */
+	.bl_duty_max = 168,
+	.bl_pwm_freq = 0x02,
+	.bl_unk_b6 = 0x02,
+
+	/*
+	 * Burst mode with the horizontal front porch blanking suppressed and
+	 * no sync pulses, which is what the vendor programs in video mode and
+	 * what the bootloader leaves in the DSIM config register.
+	 */
+	.video_mode_flags = MIPI_DSI_MODE_VIDEO |
+			    MIPI_DSI_MODE_VIDEO_BURST |
+			    MIPI_DSI_MODE_VIDEO_NO_HFP,
+
+	/* Power sequencing, from the vendor board file */
+	.iovcc_to_vdd_delay_ms = 10,
+	.vdd_to_reset_delay_ms = 15,
+	.reset_pulse_ms = 10,
+};
+
 static const struct hx8279_panel_desc chunghwa_hx8279d_gtaxl = {
 	.dsi_info = {
 		.type = "HX8279D-CPT",
@@ -2101,11 +2203,54 @@
 	.reset_pulse_ms = 10,
 };
 
+static const struct hx8279_panel_desc chunghwa_hx8279d_gtanotexl = {
+	.dsi_info = {
+		.type = "HX8279D-CPT",
+		.channel = 0,
+		.node = NULL,
+	},
+	.mode_data = gtanotexl_modes,
+	.num_modes = ARRAY_SIZE(gtanotexl_modes),
+	.num_lanes = 4,
+
+	/* Driver/Module, GOA and gamma configuration from the vendor */
+	.init_regs = chunghwa_hx8279d_gtaxl_init,
+	.num_init_regs = ARRAY_SIZE(chunghwa_hx8279d_gtaxl_init),
+
+	/* MIPI Configuration */
+	.eotp_ctl = 0xe5,
+	.bta_tlpx = 2,
+	.lhs_settle_time_by_osc25 = true,
+	.ths_settle_time = 2,
+
+	/* Backlight over DSI */
+	.bl_duty_max = 168,
+	.bl_pwm_freq = 0x02,
+	.bl_unk_b6 = 0x02,
+
+	/*
+	 * Burst mode with the horizontal front porch blanking suppressed and
+	 * no sync pulses, which is what the vendor programs in video mode and
+	 * what the bootloader leaves in the DSIM config register.
+	 */
+	.video_mode_flags = MIPI_DSI_MODE_VIDEO |
+			    MIPI_DSI_MODE_VIDEO_BURST |
+			    MIPI_DSI_MODE_VIDEO_NO_HFP,
+
+	/* Power sequencing, from the vendor board file */
+	.iovcc_to_vdd_delay_ms = 10,
+	.vdd_to_reset_delay_ms = 15,
+	.reset_pulse_ms = 10,
+};
+
 static const struct of_device_id hx8279_of_match[] = {
 	{ .compatible = "aoly,sl101pm1794fog-v15", .data = &aoly_sl101pm1794fog_v15 },
 	{ .compatible = "boe,hx8279d-gtaxl", .data = &boe_hx8279d_gtaxl },
+	{ .compatible = "boe,hx8279d-gtanotexl", .data = &boe_hx8279d_gtanotexl },
 	{ .compatible = "boe,hx8279d-gtaxl-v2", .data = &boe_hx8279d_gtaxl_v2 },
+	{ .compatible = "boe,hx8279d-gtanotexl-v2", .data = &boe_hx8279d_gtanotexl_v2 },
 	{ .compatible = "chunghwa,hx8279d-gtaxl", .data = &chunghwa_hx8279d_gtaxl },
+	{ .compatible = "chunghwa,hx8279d-gtanotexl", .data = &chunghwa_hx8279d_gtanotexl },
 	{ .compatible = "startek,kd070fhfid078", .data = &startek_kd070fhfid078 },
 	{ /* sentinel */ }
 };
diff --git a/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml b/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml
--- a/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml
+++ b/Documentation/devicetree/bindings/display/panel/himax,hx8279.yaml
@@ -39,6 +39,9 @@
           - boe,hx8279d-gtaxl
           - boe,hx8279d-gtaxl-v2
           - chunghwa,hx8279d-gtaxl
+          - boe,hx8279d-gtanotexl
+          - boe,hx8279d-gtanotexl-v2
+          - chunghwa,hx8279d-gtanotexl
           - startek,kd070fhfid078
       - const: himax,hx8279
 
