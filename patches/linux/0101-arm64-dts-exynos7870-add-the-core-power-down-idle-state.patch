From f00db0bf01c1a99826ee56a48f4c2f387eed2d20 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Tue, 29 Sep 2026 17:40:38 +0200
Subject: [PATCH] arm64: dts: exynos7870: add the core power-down idle state

Describe the per-core PSCI power-down state (0x10000) and reference it
from all eight cores. The latencies come from the vendor device tree:
35 us entry, 90 us exit, 750 us minimum residency. The vendor kernel
runs the per-cpu tick on the MCT, which stays powered; here the per-cpu
tick is the arch timer, which is lost with the core, hence
local-timer-stop. The firmware only returns from the state once
exynos-pmu has prepared the PMU for it.

The state is added disabled: with cores powering down in idle the
system still locks up under load. The description stays so that the
state can be enabled once the lockup is understood.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 28 ++++++++++++++++++++++
 1 file changed, 28 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index ef684a34fd..bbbfd4708a 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -74,6 +74,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x0>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 			clocks = <&cmu_cpucl0 CLK_CLUSTER0_SCLK>;
 			clock-names = "cluster0_clk";
 			#cooling-cells = <2>;
@@ -84,6 +85,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x1>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 		};
 
 		cpu2: cpu@2 {
@@ -91,6 +93,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x2>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 		};
 
 		cpu3: cpu@3 {
@@ -98,6 +101,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x3>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 		};
 
 		cpu4: cpu@100 {
@@ -105,6 +109,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x100>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 			clocks = <&cmu_cpucl1 CLK_CLUSTER1_SCLK>;
 			clock-names = "cluster1_clk";
 			#cooling-cells = <2>;
@@ -115,6 +120,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x101>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 		};
 
 		cpu6: cpu@102 {
@@ -122,6 +128,7 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x102>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
 		};
 
 		cpu7: cpu@103 {
@@ -129,6 +136,27 @@
 			compatible = "arm,cortex-a53";
 			reg = <0x103>;
 			enable-method = "psci";
+			cpu-idle-states = <&cpu_sleep>;
+		};
+
+		idle-states {
+			entry-method = "psci";
+
+			/*
+			 * Core power-down. The firmware needs the PMU prepared
+			 * by the kernel (exynos-pmu), and the arch timer is
+			 * lost with the core. Disabled: the system locks up
+			 * under load with it, and cpuidle uses WFI alone.
+			 */
+			cpu_sleep: cpu-sleep {
+				compatible = "arm,idle-state";
+				status = "disabled";
+				arm,psci-suspend-param = <0x10000>;
+				local-timer-stop;
+				entry-latency-us = <35>;
+				exit-latency-us = <90>;
+				min-residency-us = <750>;
+			};
 		};
 	};
 
