From 3c4a141708e7867a9942e0c16ccf191373db2f79 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 10 Oct 2026 23:34:57 +0200
Subject: [PATCH] iommu/exynos: write the zero level 2 table out to memory

Unmapped sections link to zero_lv2_table, which is allocated zeroed in
the CPU cache and never cleaned to memory, while the page table walker
reads memory. Every other table goes through the DMA API: map this one
too, once the first SysMMU becomes the DMA device.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/iommu/exynos-iommu.c | 16 +++++++++++++++-
 1 file changed, 15 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/exynos-iommu.c b/drivers/iommu/exynos-iommu.c
index 7f141bb44a..16c18ad474 100644
--- a/drivers/iommu/exynos-iommu.c
+++ b/drivers/iommu/exynos-iommu.c
@@ -835,8 +835,22 @@ static int exynos_sysmmu_probe(struct platform_device *pdev)
 	 * use the first registered sysmmu device for performing
 	 * dma mapping operations on iommu page tables (cpu cache flush)
 	 */
-	if (!dma_dev)
+	if (!dma_dev) {
+		dma_addr_t handle;
+
 		dma_dev = &pdev->dev;
+		/*
+		 * Unmapped sections point at zero_lv2_table: write its zeros
+		 * out to memory, where the page table walker reads them.
+		 */
+		handle = dma_map_single(dma_dev, zero_lv2_table, LV2TABLE_SIZE,
+					DMA_TO_DEVICE);
+		if (dma_mapping_error(dma_dev, handle)) {
+			dma_dev = NULL;
+			ret = -ENOMEM;
+			goto err_dma_set_mask;
+		}
+	}
 
 	pm_runtime_enable(dev);
 
