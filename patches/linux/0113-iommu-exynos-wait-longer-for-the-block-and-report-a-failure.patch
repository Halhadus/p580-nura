From 85b49fbf278f1aee31951b13cf04c519d5db262a Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 10 Oct 2026 23:35:09 +0200
Subject: [PATCH] iommu/exynos: wait longer for the block and report a failure

When the block did not take effect within 120 reads of MMU_STATUS,
sysmmu_block() gave up and its callers silently skipped the TLB
invalidation, leaving stale entries behind. Poll up to 4096 times, as
the enable path does, and warn when it still fails.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/iommu/exynos-iommu.c | 4 +++-
 1 file changed, 3 insertions(+), 1 deletion(-)

diff --git a/drivers/iommu/exynos-iommu.c b/drivers/iommu/exynos-iommu.c
index 16c18ad474..fa80202049 100644
--- a/drivers/iommu/exynos-iommu.c
+++ b/drivers/iommu/exynos-iommu.c
@@ -432,7 +432,7 @@ static void sysmmu_unblock(struct sysmmu_drvdata *data)
 
 static bool sysmmu_block(struct sysmmu_drvdata *data)
 {
-	int i = 120;
+	int i = 4096;
 
 	writel(CTRL_BLOCK, data->sfrbase + REG_MMU_CTRL);
 	while ((i > 0) && !(readl(data->sfrbase + REG_MMU_STATUS) & 1))
@@ -440,6 +440,8 @@ static bool sysmmu_block(struct sysmmu_drvdata *data)
 
 	if (!(readl(data->sfrbase + REG_MMU_STATUS) & 1)) {
 		sysmmu_unblock(data);
+		/* the caller skips the TLB invalidation */
+		dev_warn_ratelimited(data->sysmmu, "failed to block, TLB not invalidated\n");
 		return false;
 	}
 
