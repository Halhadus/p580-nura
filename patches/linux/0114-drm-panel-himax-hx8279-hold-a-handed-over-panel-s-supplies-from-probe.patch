From 341d951cf4678283bb6ef40e447020305865224f Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sun, 11 Oct 2026 11:59:50 +0200
Subject: [PATCH] drm/panel: himax-hx8279: hold a handed-over panel's supplies
 from probe

The references on the supplies of a panel left running by the bootloader
were only taken at the first prepare(). Until then the regulators have no
enabled consumer, and the regulator core switches them off as unused 30
seconds after boot: on a first boot apexd decompresses the APEXes for
about 50 seconds before the display is started, and the boot logo turned
into a black screen at 31.7 s.

Take the references at probe, before drm_panel_add(), and drop them on
removal if the panel was never prepared.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/gpu/drm/panel/panel-himax-hx8279.c | 39 +++++++++++++++++-----
 1 file changed, 30 insertions(+), 9 deletions(-)

diff --git a/drivers/gpu/drm/panel/panel-himax-hx8279.c b/drivers/gpu/drm/panel/panel-himax-hx8279.c
index 580351de87..ee6121fccb 100644
--- a/drivers/gpu/drm/panel/panel-himax-hx8279.c
+++ b/drivers/gpu/drm/panel/panel-himax-hx8279.c
@@ -981,15 +981,9 @@ static int hx8279_prepare(struct drm_panel *panel)
 
 	if (hx->handoff) {
 		/*
-		 * Take the regulator references so that the counts stay
-		 * balanced against unprepare(), but leave the hardware
-		 * exactly as the bootloader left it.
-		 */
-		ret = regulator_bulk_enable(ARRAY_SIZE(hx->vregs), hx->vregs);
-		if (ret)
-			return ret;
-
-		/*
+		 * The regulator references were taken at probe: leave the
+		 * hardware exactly as the bootloader left it.
+		 *
 		 * The DriverIC is on whatever page the bootloader left it:
 		 * invalidate the cache so the first page switch is sent.
 		 */
@@ -1397,6 +1391,15 @@ static int hx8279_check_params(struct hx8279 *hx, struct device *dev)
 	return 0;
 }
 
+static void hx8279_handoff_release(void *data)
+{
+	struct hx8279 *hx = data;
+
+	/* Never prepared: drop the references taken at probe */
+	if (hx->handoff)
+		regulator_bulk_disable(ARRAY_SIZE(hx->vregs), hx->vregs);
+}
+
 static int hx8279_probe(struct mipi_dsi_device *dsi)
 {
 	struct device *dev = &dsi->dev;
@@ -1500,6 +1503,24 @@ static int hx8279_probe(struct mipi_dsi_device *dsi)
 	if (ret)
 		return ret;
 
+	/*
+	 * Hold the supplies of a panel handed over running until the first
+	 * prepare(): with no consumer enabling them, the regulator core
+	 * switches them off as unused 30 seconds after boot, and the panel
+	 * goes dark if userspace has not started the display by then, as on
+	 * a first boot that decompresses the APEXes. This is done before
+	 * drm_panel_add(), so prepare() cannot run earlier.
+	 */
+	if (hx->handoff) {
+		ret = regulator_bulk_enable(ARRAY_SIZE(hx->vregs), hx->vregs);
+		if (ret)
+			return ret;
+
+		ret = devm_add_action_or_reset(dev, hx8279_handoff_release, hx);
+		if (ret)
+			return ret;
+	}
+
 	drm_panel_add(&hx->panel);
 
 	for (i = 0; i < 2; i++) {
