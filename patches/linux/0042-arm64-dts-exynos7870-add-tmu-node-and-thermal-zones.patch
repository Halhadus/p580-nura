From 5826578fcec3af6b8fe55857a710b4022e01e657 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Sat, 29 Aug 2026 15:57:52 +0000
Subject: [PATCH] arm64: dts: exynos7870: add TMU node and thermal zones

One physical sensor serves the whole SoC (the three vendor "instances"
are the same base 0x10130000 with different trip tables), so: one tmu
node, one thermal zone, and cooling maps for both CPU clusters and the
GPU.

The tmu node takes all six PERI gates: the register file aborts
without the CPUCL0 APB gate, and gating a sensor sclk while the block
is live hangs the interconnect, so the driver enables them in bulk.
The interrupt is GIC SPI 435, from the vendor device tree.

Trips and clips are those of the ECT AP_THERMAL block decoded from this
SoC's parameter ROM, with 5 C bands (hysteresis 5000): GPU steps at
86/91/96/101 C (845/728/545/343 MHz), CPU steps at 91 C (1248 MHz) and
101 C (546 MHz). The vendor steps at 76 and 81 C clip at 1690 and
1586 MHz, at or above the highest level the tested chip runs at, so
they would be no-ops and are omitted. The vendor CPUCL1 hotplug above
96 C becomes deep throttling on both clusters, and the vendor HW_TRIP
at 115 C becomes the critical trip. The maps are pinned [n,n] to
reproduce the fixed clip of each vendor band.

#cooling-cells on cpu0 and cpu4 makes cpufreq-dt register the two
policy cooling devices; on the gpu node it gives panfrost its devfreq
cooling device.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 arch/arm64/boot/dts/exynos/exynos7870.dtsi | 97 ++++++++++++++++++++++
 1 file changed, 97 insertions(+)

diff --git a/arch/arm64/boot/dts/exynos/exynos7870.dtsi b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
index a945c3e551..9b5ca42add 100644
--- a/arch/arm64/boot/dts/exynos/exynos7870.dtsi
+++ b/arch/arm64/boot/dts/exynos/exynos7870.dtsi
@@ -76,6 +76,7 @@
 			enable-method = "psci";
 			clocks = <&cmu_cpucl0 CLK_CLUSTER0_SCLK>;
 			clock-names = "cluster0_clk";
+			#cooling-cells = <2>;
 		};
 
 		cpu1: cpu@1 {
@@ -106,6 +107,7 @@
 			enable-method = "psci";
 			clocks = <&cmu_cpucl1 CLK_CLUSTER1_SCLK>;
 			clock-names = "cluster1_clk";
+			#cooling-cells = <2>;
 		};
 
 		cpu5: cpu@101 {
@@ -163,6 +165,77 @@
 		cpu_on = <0xc4000003>;
 	};
 
+	/*
+	 * A single thermal zone: there is one sensor for the whole SoC. Trips
+	 * and clips from the vendor ECT AP_THERMAL block, in 5 C bands. The
+	 * vendor steps at 76 and 81 C clip above the highest enabled CPU level
+	 * and are left out; the vendor hotplug of CPUCL1 above 96 C becomes a
+	 * deep throttle of both clusters. The vendor hardware trip at 115 C is
+	 * the critical trip.
+	 *
+	 * CPU cooling states (OPP 0..12): 3 = 1248 MHz, 10 = 546 MHz.
+	 * GPU cooling states (OPP 0..6): 1 = 845, 2 = 728, 4 = 545, 6 = 343.
+	 * Each map pins a single state, as the vendor bands do.
+	 */
+	thermal-zones {
+		soc_thermal: soc-thermal {
+			polling-delay-passive = <0>;
+			polling-delay = <0>;
+			thermal-sensors = <&tmu>;
+
+			trips {
+				soc_alert0: soc-alert0 {
+					temperature = <86000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				soc_alert1: soc-alert1 {
+					temperature = <91000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				soc_alert2: soc-alert2 {
+					temperature = <96000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				soc_alert3: soc-alert3 {
+					temperature = <101000>;
+					hysteresis = <5000>;
+					type = "passive";
+				};
+				soc_crit: soc-crit {
+					temperature = <115000>;
+					hysteresis = <0>;
+					type = "critical";
+				};
+			};
+
+			cooling-maps {
+				map0 {
+					trip = <&soc_alert0>;
+					cooling-device = <&gpu 1 1>;
+				};
+				map1 {
+					trip = <&soc_alert1>;
+					cooling-device = <&cpu0 3 3>,
+							 <&cpu4 3 3>,
+							 <&gpu 2 2>;
+				};
+				map2 {
+					trip = <&soc_alert2>;
+					cooling-device = <&gpu 4 4>;
+				};
+				map3 {
+					trip = <&soc_alert3>;
+					cooling-device = <&cpu0 10 10>,
+							 <&cpu4 10 10>,
+							 <&gpu 6 6>;
+				};
+			};
+		};
+	};
+
 	soc: soc@0 {
 		compatible = "simple-bus";
 		ranges = <0x0 0x0 0x0 0x20000000>;
@@ -175,6 +248,29 @@
 			reg = <0x10100000 0x100>;
 		};
 
+		/*
+		 * One physical sensor (TEM1455X) for the whole SoC: the three
+		 * vendor instances (CPUCL0/CPUCL1/G3D) share this base with
+		 * different trips. The register file needs the CPUCL0 APB
+		 * clock, and gating an sclk while the block is live hangs the
+		 * interconnect, so the driver keeps all six gates on.
+		 */
+		tmu: thermal-sensor@10130000 {
+			compatible = "samsung,exynos7870-tmu";
+			reg = <0x10130000 0x200>;
+			interrupts = <GIC_SPI 435 IRQ_TYPE_LEVEL_HIGH>;
+			clock-names = "tmu_cpucl0_apbif", "tmu_cpucl1_apbif",
+				      "tmu_apbif", "tmu_cpucl0_sclk",
+				      "tmu_cpucl1_sclk", "tmu_sclk";
+			clocks = <&cmu_peri CLK_GOUT_PERI_SFRIF_TMU_CPUCL0_PCLK>,
+				 <&cmu_peri CLK_GOUT_PERI_SFRIF_TMU_CPUCL1_PCLK>,
+				 <&cmu_peri CLK_GOUT_PERI_SFRIF_TMU_PCLK>,
+				 <&cmu_peri CLK_GOUT_PERI_TMU_CPUCL0_CLK>,
+				 <&cmu_peri CLK_GOUT_PERI_TMU_CPUCL1_CLK>,
+				 <&cmu_peri CLK_GOUT_PERI_TMU_CLK>;
+			#thermal-sensor-cells = <0>;
+		};
+
 		cmu_peri: clock-controller@101f0000 {
 			compatible = "samsung,exynos7870-cmu-peri";
 			reg = <0x101f0000 0x1000>;
@@ -300,6 +396,7 @@
 		};
 
 		gpu: gpu@11400000 {
+			#cooling-cells = <2>;
 			compatible = "samsung,exynos7870-mali", "arm,mali-t830";
 			reg = <0x11400000 0x5000>;
 			interrupt-names = "job", "mmu", "gpu";
