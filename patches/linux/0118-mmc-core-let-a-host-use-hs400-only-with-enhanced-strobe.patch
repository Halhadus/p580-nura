From c71460d6900dff3882b96ac0cbf269cf042ba1a9 Mon Sep 17 00:00:00 2001
From: Alessandro Fontana <alessandro.fontana@pm.me>
Date: Wed, 28 Oct 2026 11:13:56 +0100
Subject: [PATCH] mmc: core: let a host use HS400 only with enhanced strobe

Plain HS400 relies on the host sampling read data at a fixed strobe
delay, which on some boards is only known to work for the card it was
measured on. Such a host can still run cards that support enhanced
strobe in HS400ES, but should keep every other card in HS200 rather
than fall back to plain HS400.

Add MMC_CAP2_HS400_ES_ONLY: when it is set and HS400ES is not
available, drop HS400 from the card types to select.

Assisted-by: LLM
Signed-off-by: Alessandro Fontana <alessandro.fontana@pm.me>
---
 drivers/mmc/core/mmc.c   | 2 ++
 include/linux/mmc/host.h | 1 +
 2 files changed, 3 insertions(+)

diff --git a/drivers/mmc/core/mmc.c b/drivers/mmc/core/mmc.c
index 05444ecf39..b95e1f1843 100644
--- a/drivers/mmc/core/mmc.c
+++ b/drivers/mmc/core/mmc.c
@@ -260,6 +260,8 @@ static void mmc_select_card_type(struct mmc_card *card)
 	    card->ext_csd.strobe_support &&
 	    (avail_type & EXT_CSD_CARD_TYPE_HS400))
 		avail_type |= EXT_CSD_CARD_TYPE_HS400ES;
+	else if (caps2 & MMC_CAP2_HS400_ES_ONLY)
+		avail_type &= ~EXT_CSD_CARD_TYPE_HS400;
 
 	card->ext_csd.hs_max_dtr = hs_max_dtr;
 	card->ext_csd.hs200_max_dtr = hs200_max_dtr;
diff --git a/include/linux/mmc/host.h b/include/linux/mmc/host.h
index ba84f02c2a..c93eeccb92 100644
--- a/include/linux/mmc/host.h
+++ b/include/linux/mmc/host.h
@@ -463,6 +463,7 @@ struct mmc_host {
 #define MMC_CAP2_CRYPTO		0
 #endif
 #define MMC_CAP2_ALT_GPT_TEGRA	(1 << 28)	/* Host with eMMC that has GPT entry at a non-standard location */
+#define MMC_CAP2_HS400_ES_ONLY	(1 << 29)	/* HS400 only with enhanced strobe */
 
 	bool			uhs2_sd_tran;	/* UHS-II flag for SD_TRAN state */
 	bool			uhs2_app_cmd;	/* UHS-II flag for APP command */
