From: Halhadus <eneshakan45@proton.me>
Subject: [PATCH] ipa: libipa: add P580 sensor analogue-gain helpers

The P580 drivers expose S5K4H5YC gain in 1/32 units and SR259 gain in
1/16 units. SR259's nonlinear hardware-register conversion is already
inside its kernel driver and must not be repeated by the IPA helper.
Register only these proven control-unit conversions. Leave black levels,
pixel sizes, colour calibration and optical metadata unspecified.

Signed-off-by: Halhadus <eneshakan45@proton.me>
---
diff --git a/src/ipa/libipa/camera_sensor_helper.cpp b/src/ipa/libipa/camera_sensor_helper.cpp
--- a/src/ipa/libipa/camera_sensor_helper.cpp
+++ b/src/ipa/libipa/camera_sensor_helper.cpp
@@ -745,6 +745,28 @@
 };
 REGISTER_CAMERA_SENSOR_HELPER("ov13858", CameraSensorHelperOv13858)

+class CameraSensorHelperS5k4h5yc : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperS5k4h5yc()
+	{
+		/* V4L2_CID_ANALOGUE_GAIN is exposed in 1/32 steps. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 32 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("s5k4h5yc", CameraSensorHelperS5k4h5yc)
+
+class CameraSensorHelperSr259 : public CameraSensorHelper
+{
+public:
+	CameraSensorHelperSr259()
+	{
+		/* The driver exposes 1/16 steps, not the sensor register code. */
+		gain_ = AnalogueGainLinear{ 1, 0, 0, 16 };
+	}
+};
+REGISTER_CAMERA_SENSOR_HELPER("sr259", CameraSensorHelperSr259)
+
 #endif /* __DOXYGEN__ */

 } /* namespace ipa */
